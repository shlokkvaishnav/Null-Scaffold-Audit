[
  {
    "id": "coulomb_force",
    "name": "Coulomb's law",
    "formula": "q1 * q2 / (4 * pi * eps0 * r**2)",
    "variables": ["q1", "q2", "eps0", "r"],
    "ranges": {
      "q1": [1.0, 5.0],
      "q2": [1.0, 5.0],
      "eps0": [1.0, 2.0],
      "r": [1.0, 10.0]
    },
    "n_vars": 4
  },
  {
    "id": "newton_gravitation",
    "name": "Newton's law of gravitation",
    "formula": "G * m1 * m2 / r**2",
    "variables": ["G", "m1", "m2", "r"],
    "ranges": {
      "G": [0.5, 2.0],
      "m1": [1.0, 20.0],
      "m2": [1.0, 20.0],
      "r": [1.0, 10.0]
    },
    "n_vars": 4
  },
  {
    "id": "ideal_gas_law",
    "name": "Ideal gas law (pressure)",
    "formula": "n * R * T / V",
    "variables": ["n", "R", "T", "V"],
    "ranges": {
      "n": [1.0, 10.0],
      "R": [1.0, 10.0],
      "T": [200.0, 400.0],
      "V": [1.0, 20.0]
    },
    "n_vars": 4
  },
  {
    "id": "kinetic_energy",
    "name": "Kinetic energy",
    "formula": "0.5 * m * v**2",
    "variables": ["m", "v"],
    "ranges": {
      "m": [0.1, 20.0],
      "v": [0.1, 30.0]
    },
    "n_vars": 2
  },
  {
    "id": "relativistic_energy_momentum",
    "name": "Relativistic energy-momentum relation",
    "formula": "sqrt((m * c**2)**2 + (p * c)**2)",
    "variables": ["m", "c", "p"],
    "ranges": {
      "m": [0.1, 10.0],
      "c": [1.0, 5.0],
      "p": [0.1, 10.0]
    },
    "n_vars": 3
  },
  {
    "id": "snells_law",
    "name": "Snell's law (refraction angle ratio)",
    "formula": "n1 * sin(theta1) / n2",
    "variables": ["n1", "theta1", "n2"],
    "ranges": {
      "n1": [1.0, 2.5],
      "theta1": [0.05, 1.4],
      "n2": [1.0, 2.5]
    },
    "n_vars": 3
  },
  {
    "id": "shm_period",
    "name": "Simple harmonic motion period",
    "formula": "2 * pi * sqrt(m / k)",
    "variables": ["m", "k"],
    "ranges": {
      "m": [0.1, 10.0],
      "k": [1.0, 50.0]
    },
    "n_vars": 2
  },
  {
    "id": "ohms_law",
    "name": "Ohm's law",
    "formula": "I * R",
    "variables": ["I", "R"],
    "ranges": {
      "I": [0.01, 10.0],
      "R": [1.0, 100.0]
    },
    "n_vars": 2
  },
  {
    "id": "doppler_effect",
    "name": "Doppler effect (non-relativistic, observer moving)",
    "formula": "f0 * (v + vo) / v",
    "variables": ["f0", "v", "vo"],
    "ranges": {
      "f0": [20.0, 2000.0],
      "v": [300.0, 350.0],
      "vo": [-50.0, 50.0]
    },
    "n_vars": 3
  },
  {
    "id": "planck_spectral_radiance",
    "name": "Planck's law spectral energy density factor",
    "formula": "1 / (exp(h * f / (k * T)) - 1)",
    "variables": ["h", "f", "k", "T"],
    "ranges": {
      "h": [0.1, 1.0],
      "f": [1.0, 5.0],
      "k": [0.5, 1.5],
      "T": [50.0, 500.0]
    },
    "n_vars": 4
  },
  {
    "id": "projectile_range",
    "name": "Projectile range on level ground",
