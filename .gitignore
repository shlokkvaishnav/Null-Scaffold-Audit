# Python
__pycache__/
*.py[cod]
*$py.class

# Juptyer
.ipynb_checkpoints/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Data
data/raw/
data/processed/
data/cache/
*.nc
*.h5
*.csv

# Results are generated and mostly bulky, so the directory is excluded --
# with one deliberate exception.
#
# The audit's artifacts are the evidence for every claim this project makes.
# `scripts/run_null_scaffold_audit.py` says that every number reported here is
# read from these files and none is typed into prose by hand, and that sentence
# is worth nothing if the files exist only on one laptop. Excluding them made
# the record unverifiable by anyone else and destroyable by a disk failure.
# They are a few hundred kilobytes of JSON and CSV.
#
# Git cannot re-include a file whose parent directory is excluded, so the
# directories are opened up one level at a time and only the two artifact
# filenames are let through. Everything else under results/ stays ignored.
results/*
!results/*/
results/*/*
!results/*/audit.json
!results/*/audit.csv
!results/*/ceiling.json
!results/*/ceiling.csv
!results/*/summary.md
!results/*/summary.csv
!results/*/*/
results/*/*/*
!results/*/*/audit.json
!results/*/*/audit.csv
# Scratch runs from wiring a flag are not results. Named rather than
# deleted, so the pattern above stays the simple one.
results/*smoke*/
wandb/
mlruns/

# Generated images (but allow docs/images for documentation)
*.png
!docs/images/*.png
*.jpg
!docs/images/*.jpg

# IDE
.vscode/
.idea/

# Distribution
dist/
build/
*.egg-info/

# Coverage artifacts (generated; regenerate with the pytest command in CONTRIBUTING.md)
.coverage
.coverage.*
htmlcov/

audit_run.log

# Build artifacts
*.egg-info/

# Sweep logs -- regenerated by scripts/run_null_scaffold_audit.py
*.log

# Local agent session state
.claude/
