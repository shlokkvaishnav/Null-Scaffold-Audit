# Add to .gitignore
$gitignoreContent = @"

# Generated outputs
figures/*.png
figures/*.pdf
figures/*.svg
results/*.csv
results/*.txt
checkpoints/*.pth
checkpoints/ensemble/*/gating.pth

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# PySR temporary files
pysr_tmp/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Environment
.env
*.log

# Data (optional - if too large for git)
data/raw/*.nc
data/processed/*.nc
"@

Add-Content -Path ".gitignore" -Value $gitignoreContent
Write-Host "✓ .gitignore updated" -ForegroundColor Green