# Docker ignore file
# Exclude unnecessary files from Docker build context

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Data (mount instead)
data/raw/*
data/processed/*
!data/.gitkeep

# Outputs (mount instead)
checkpoints/*
figures/*
equations/*
results/*
mlruns/*

# Logs
*.log
logs/

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Documentation build
docs/_build/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Large files
*.nc
*.h5
*.hdf5
*.zarr
