# SD-MoSE Environment Configuration
# Copy this to .env and fill in your values

# =============================================================================
# COPERNICUS MARINE SERVICE CREDENTIALS
# =============================================================================
# Register at https://data.marine.copernicus.eu/register
COPERNICUS_USERNAME=svaishnav
COPERNICUS_PASSWORD=Shlok@241206

# =============================================================================
# COMPUTE RESOURCES
# =============================================================================
# GPU device (leave empty for CPU, or set to specific GPU like "0" or "cuda:0")
CUDA_VISIBLE_DEVICES=

# Number of CPU cores for parallel processing
NUM_WORKERS=4

# Maximum memory for Dask arrays (e.g., "8GB")
DASK_MEMORY_LIMIT=8GB

# =============================================================================
# JULIA/PYSR CONFIGURATION
# =============================================================================
# Path to Julia executable (auto-detected if in PATH)
# JULIA_PATH=/usr/local/bin/julia

# Number of PySR parallel processes
PYSR_PROCS=4

# =============================================================================
# DATA PATHS (override defaults if needed)
# =============================================================================
# RAW_DATA_DIR=/custom/path/to/raw
# PROCESSED_DATA_DIR=/custom/path/to/processed

# =============================================================================
# TRAINING CONFIGURATION
# =============================================================================
# Random seed for reproducibility
RANDOM_SEED=42

# Training device: cpu, cuda, mps (for Apple Silicon)
DEVICE=cpu

# Mixed precision training (true/false)
USE_AMP=false

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Weights & Biases (optional - for experiment tracking)
# WANDB_API_KEY=your_wandb_key
# WANDB_PROJECT=sdmose
# WANDB_ENTITY=your_username

# =============================================================================
# FIGURE GENERATION
# =============================================================================
# Figure DPI for publication-quality outputs
FIGURE_DPI=300

# Figure format: png, pdf, svg
FIGURE_FORMAT=png